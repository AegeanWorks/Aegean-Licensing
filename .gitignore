# AIKit transient state
.aikit/*.lock
.aikit/*.bak
.aikit/*.tmp_*
.aikit/*.corrupt_*
__pycache__/
*.py[cod]
node_modules/

# Issued customer certificates contain licensee PII; never commit them
issued_certs/


# Python packaging artifacts
build/
dist/
*.egg-info/

# Register write lock (transient)
licenses/*.lock
